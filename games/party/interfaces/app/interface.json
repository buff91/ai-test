{
  "connector": "socket",
  "display": "visible",
  "continuous": false,
  "interval_ms": 1000,
  "max_age_ms": 2500,
  "actions": {
    "attack": "attack",
    "aoe_skill": "aoe_skill",
    "heal": "heal",
    "guard": "guard",
    "use_item": "use_item"
  },
  "launch": {
    "command": [
      "{python}",
      "-m",
      "gamelab.desktop_game",
      "--game",
      "party"
    ],
    "socket_arg": "--socket",
    "sources": [
      "gamelab/desktop_game.py",
      "gamelab/presentation.py",
      "gamelab/screens.py",
      "sims/party.py",
      "sims/base.py",
      "sims/service.py",
      "gamelab/protocol.py",
      "kbm/keys.py"
    ]
  },
  "manual": "게임 창에서 키보드 또는 버튼으로 직접 조작할 수 있습니다. N으로 상황을 바꾸고 모델 실행을 눌러 입력을 비교하세요."
}
