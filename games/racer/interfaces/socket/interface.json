{
  "connector": "socket",
  "launch": {
    "command": [
      "{python}",
      "-m",
      "sims",
      "serve",
      "racer"
    ],
    "socket_arg": "--socket"
  },
  "interval_ms": 200,
  "actions": {
    "accelerate": "accelerate",
    "brake": "brake",
    "steer_left": "steer_left",
    "steer_right": "steer_right",
    "boost": "boost",
    "keep": "keep"
  }
}
