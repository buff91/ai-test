{
  "connector": "kbm",
  "display": "visible",
  "continuous": true,
  "window": {
    "owner": "python",
    "title_contains": "Teaching Lab - Lane Racer"
  },
  "interval_ms": 1000,
  "max_age_ms": 2500,
  "max_action_ms": 300,
  "pause_key": "p",
  "reflex_hz": 0,
  "decision_keys": [],
  "actions": {
    "accelerate": [
      {
        "tap": "up",
        "ms": 30
      }
    ],
    "brake": [
      {
        "tap": "down",
        "ms": 30
      }
    ],
    "steer_left": [
      {
        "tap": "left",
        "ms": 30
      }
    ],
    "steer_right": [
      {
        "tap": "right",
        "ms": 30
      }
    ],
    "boost": [
      {
        "tap": "space",
        "ms": 30
      }
    ],
    "keep": [
      {
        "tap": "w",
        "ms": 30
      }
    ]
  },
  "manual": "게임 창 준비를 누르거나 uv run python -m gamelab.desktop_game --game racer --socket /tmp/teaching-racer.sock 로 먼저 실행하세요. 키마는 화면의 숫자·색상 계기를 캡처해 읽고 실제 키를 보냅니다. KbmAgent의 화면 기록·손쉬운 사용 권한을 확인하고 입력 전 게임 창을 앞으로 가져오세요. 연결 해제 후에도 준비한 창은 유지됩니다."
}
